{
  "description": "Well-known public MCP servers to audit with `npm run scan:registry`. Running this executes third-party code via npx — use --sandbox docker or a disposable VM for untrusted servers. The committed FINDINGS.md was produced by an actual run. Optional per-server `env` supplies PLACEHOLDER credentials so credential-gated servers complete the MCP handshake and advertise their tools; the values are fake and never valid, and tools are never invoked, so no real API call is ever made. Servers that still fail to boot are recorded as non-connecting — itself a datapoint.",
  "servers": [
    {
      "name": "@modelcontextprotocol/server-everything",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-everything"]
    },
    {
      "name": "@modelcontextprotocol/server-memory",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    {
      "name": "@modelcontextprotocol/server-sequential-thinking",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    {
      "name": "@modelcontextprotocol/server-filesystem",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
    },
    {
      "name": "@modelcontextprotocol/server-github",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "placeholder-not-a-real-token" }
    },
    {
      "name": "@modelcontextprotocol/server-gitlab",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-gitlab"],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "placeholder",
        "GITLAB_API_URL": "https://gitlab.com/api/v4"
      }
    },
    {
      "name": "@modelcontextprotocol/server-slack",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": { "SLACK_BOT_TOKEN": "placeholder", "SLACK_TEAM_ID": "T0000000000" }
    },
    {
      "name": "@modelcontextprotocol/server-postgres",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://user:pass@localhost:5432/db"
      ]
    },
    {
      "name": "@modelcontextprotocol/server-brave-search",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": { "BRAVE_API_KEY": "placeholder" }
    },
    {
      "name": "@modelcontextprotocol/server-google-maps",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-google-maps"],
      "env": { "GOOGLE_MAPS_API_KEY": "placeholder" }
    },
    {
      "name": "@modelcontextprotocol/server-puppeteer",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"]
    },
    {
      "name": "@modelcontextprotocol/server-everart",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-everart"],
      "env": { "EVERART_API_KEY": "placeholder" }
    },
    {
      "name": "@modelcontextprotocol/server-redis",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-redis", "redis://localhost:6379"]
    },
    {
      "name": "@modelcontextprotocol/server-aws-kb-retrieval",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-aws-kb-retrieval"],
      "env": {
        "AWS_ACCESS_KEY_ID": "placeholder",
        "AWS_SECRET_ACCESS_KEY": "placeholder",
        "AWS_REGION": "us-east-1"
      }
    },
    {
      "name": "firecrawl-mcp",
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": { "FIRECRAWL_API_KEY": "placeholder" }
    },
    {
      "name": "exa-mcp-server",
      "command": "npx",
      "args": ["-y", "exa-mcp-server"],
      "env": { "EXA_API_KEY": "placeholder" }
    },
    {
      "name": "tavily-mcp",
      "command": "npx",
      "args": ["-y", "tavily-mcp"],
      "env": { "TAVILY_API_KEY": "placeholder" }
    },
    {
      "name": "airtable-mcp-server",
      "command": "npx",
      "args": ["-y", "airtable-mcp-server"],
      "env": { "AIRTABLE_API_KEY": "placeholder" }
    },
    { "name": "@upstash/context7-mcp", "command": "npx", "args": ["-y", "@upstash/context7-mcp"] },
    {
      "name": "@playwright/mcp",
      "command": "npx",
      "args": ["-y", "@playwright/mcp", "--headless"]
    },
    {
      "name": "@notionhq/notion-mcp-server",
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": { "NOTION_TOKEN": "placeholder" }
    },
    {
      "name": "figma-developer-mcp",
      "command": "npx",
      "args": ["-y", "figma-developer-mcp", "--stdio"],
      "env": { "FIGMA_API_KEY": "placeholder" }
    },
    { "name": "@browsermcp/mcp", "command": "npx", "args": ["-y", "@browsermcp/mcp@latest"] },
    { "name": "mcp-server-kubernetes", "command": "npx", "args": ["-y", "mcp-server-kubernetes"] }
  ]
}
